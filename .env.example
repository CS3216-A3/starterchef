# --- AI provider -------------------------------------------------------------
# Pick a provider and set its key. Everything goes through src/lib/ai/model.ts,
# so swapping providers/models is a config change, not a code change — run
# `npm run eval` or `npm run eval -- --report` to collect comparison data.
AI_PROVIDER=google            # "google" | "openai" | "google-lite"
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-5.8-flash
GOOGLE_LITE_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Supabase ----------------------------------------------------------------
# Project Settings → API in your Supabase dashboard. New projects use publishable
# + secret keys (sb_publishable_... / sb_secret_...). Legacy anon/service_role
# keys still work during the transition.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Analytics ---------------------------------------------------------------
# PostHog project key. Leave empty to disable analytics locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- AI rate limiting --------------------------------------------------------
AI_DAILY_LIMIT=50

# --- Voice assistant ---------------------------------------------------------
# Switch between native-audio providers, or use the browser's free Web Speech API.
NEXT_PUBLIC_VOICE_PROVIDER=web-speech      # "web-speech" | "openai" | "gemini"
NEXT_PUBLIC_VOICE_SIMULATE=false           # "true" to fake a connection and test UI/metrics
# Native provider/model selection is enforced on the server. The browser value
# above only controls which UI is shown; it never selects a provider capability.
AI_REALTIME_PROVIDER=openai                # "openai" | "gemini"
# OpenAI Realtime: gpt-realtime-2.1-mini is ~3x cheaper than gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=alloy
# Gemini Live: use the latest stable live model.
GOOGLE_LIVE_MODEL=gemini-3.8-live

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
AI_GEMINI_LIVE_ENABLED=false
