# --- AI provider -------------------------------------------------------------
# Pick a provider and set its key. Everything goes through src/lib/ai/model.ts,
# so swapping providers/models is a config change, not a code change — run
# `npm run eval` under each provider to collect comparison data.
AI_PROVIDER=google            # "google" | "openai"
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Supabase ----------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics ---------------------------------------------------------------
# PostHog project key. Leave empty to disable analytics locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
