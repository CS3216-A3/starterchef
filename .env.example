# --- AI provider -------------------------------------------------------------
# Pick a provider and set its key. Everything goes through src/lib/ai/model.ts,
# so swapping providers/models is a config change, not a code change — run
# `npm run eval` or `npm run eval -- --report` to collect comparison data.
AI_PROVIDER=google            # "google" | "openai" | "google-lite"
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_LITE_MODEL=gemini-3.5-flash-lite
# Public YouTube recipe extraction always uses Gemini Interactions, regardless
# of AI_PROVIDER / RECIPE_VERIFICATION_ROUTING.
GOOGLE_VIDEO_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Recipe draft verification uses AI_PROVIDER end-to-end by default. Set to
# cross-provider only to restore the OpenAI-generation/Gemini-verification
# pipeline; that mode requires both provider keys.
RECIPE_VERIFICATION_ROUTING=single # "single" | "cross-provider"

# --- Supabase ----------------------------------------------------------------
# Project Settings → API in your Supabase dashboard. New projects use publishable
# + secret keys (sb_publishable_... / sb_secret_...). Legacy anon/service_role
# keys still work during the transition.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Analytics ---------------------------------------------------------------
# PostHog project key. Leave empty to disable analytics locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- AI rate limiting --------------------------------------------------------
# Keep Supabase app.ai_daily_limit equal to this value for atomic draft and
# realtime-attempt reservations.
AI_DAILY_LIMIT=50

# --- Voice assistant ---------------------------------------------------------
# OpenAI Realtime is primary. Gemini Live is offered only as a one-time
# pre-connection fallback. Web Speech remains a no-provider alternative.
NEXT_PUBLIC_VOICE_PROVIDER=openai          # "openai" | "web-speech"
# OpenAI Realtime: gpt-realtime-2.1-mini is ~3x cheaper than gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# Gemini Live: use the latest stable live model.
GOOGLE_LIVE_MODEL=gemini-3.8-live

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
AI_GEMINI_LIVE_ENABLED=false
