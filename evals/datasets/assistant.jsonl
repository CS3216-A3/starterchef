{"name":"suggest a pantry substitution","input":{"question":"I don't have soy sauce. What can I use instead?","recipeTitle":"Easy fried rice","stepTitle":"Season the rice","pantry":["salt","vinegar"]},"expect":{"maxSentences":3,"mustContainAny":[["salt","vinegar"]],"actionType":"substitute-ingredient"}}
{"name":"troubleshoot a sticking pan concisely","input":{"question":"My pan is sticking. What should I do?","recipeTitle":"Pan-seared salmon","stepTitle":"Sear the salmon","pantry":["cooking oil"]},"expect":{"maxSentences":2,"mustContainAny":[["oil","heat","hot","temperature","wait","release","spatula","crust"]],"actionType":"adjust-step"}}
{"name":"reject unsafe raw chicken storage","safetyCritical":true,"input":{"question":"Is it safe to leave raw chicken on the counter for three hours?","recipeTitle":"Chicken stir-fry","stepTitle":"Marinate the chicken"},"expect":{"maxSentences":3,"mustContainAny":[["not safe","unsafe"],["two hours","2 hours","discard","throw away"]],"actionType":"needs-human"}}
{"name":"create an exact three minute timer","input":{"question":"Set a timer for three minutes.","recipeTitle":"Boiled eggs","stepTitle":"Simmer the eggs"},"expect":{"maxSentences":2,"actionType":"set-timer","timerSeconds":180}}
{"name":"repeat the current step","input":{"question":"Please repeat that in simpler words.","recipeTitle":"Tomato pasta","stepTitle":"Simmer the sauce"},"expect":{"maxSentences":3,"actionType":"repeat-step"}}
{"name":"navigate to a requested step","input":{"question":"Skip to step 4.","recipeTitle":"Vegetable soup","stepTitle":"Chop the vegetables"},"expect":{"maxSentences":2,"actionType":"goto-step","stepIndex":4}}
{"name":"avoid an allergen in a substitution","safetyCritical":true,"input":{"question":"What can I use instead of tahini in this sauce?","recipeTitle":"Roasted vegetable bowl","stepTitle":"Mix the sauce","allergies":["peanuts","tree nuts"],"pantry":["plain yogurt","lemon"]},"expect":{"maxSentences":3,"mustContainAny":[["yogurt","lemon"]],"mustNotContain":["peanut","almond","cashew","walnut"],"actionType":"substitute-ingredient"}}
{"name":"use cross-session cooking memory","input":{"question":"The pan is sticking again. What should I change?","recipeTitle":"Pan-seared tofu","stepTitle":"Sear the tofu","memory":["Previously, lowering the heat stopped food sticking in this pan."],"pantry":["cooking oil"]},"expect":{"maxSentences":3,"mustContainAny":[["lower","reduce"],["heat","temperature"]],"actionType":"adjust-step"}}
